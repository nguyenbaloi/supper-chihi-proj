          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"links\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"label\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"search_text\" TEXT NOT NULL DEFAULT '');"
