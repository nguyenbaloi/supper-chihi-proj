          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"initial_contribution_amount\" INTEGER NOT NULL, \"start_date\" TEXT NOT NULL, \"fx_rate_manual_amount\" INTEGER NULL, \"drift_threshold_bp\" INTEGER NOT NULL DEFAULT 500, \"last_exported_at\" TEXT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"onboarding_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_completed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
